# Server
PORT=5000
NODE_ENV=development
# Generate with: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:3200

# Database
DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=hms
DB_USER=hms
DB_PASSWORD=your-db-password

# AI (optional — works without a key using the built-in local engine)
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# Only set to the number of trusted proxy hops when direct API access is blocked.
TRUST_PROXY=0
# Demo account discovery is disabled in production.
ENABLE_DEMO_ACCOUNTS=false
